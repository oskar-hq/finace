# Kopieren nach .env und ausfuellen:  cp .env.example .env
# .env ist per .gitignore ausgeschlossen und darf NIE eingecheckt werden.

# --- Optional: KI-Erklaerungen ---
# Ohne diesen Key laeuft "npm run update" vollstaendig durch und schreibt die
# Marktdaten - es fehlen dann nur die Erklaerungstexte, das Glossar und die
# Gesamteinschaetzung. Das Dashboard bleibt voll benutzbar.
# Key holen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Stark empfohlen fuer Server-Betrieb ---
# Twelve Data, kostenloser Tarif: https://twelvedata.com/pricing
# Wichtig, wenn das Dashboard auf einem Server/VPS laeuft: stooq blockt
# Rechenzentrums-IPs, und Yahoos inoffizielle API antwortet von dort meist mit
# HTTP 429. Ohne diesen Key haben Gold, DAX und VIX faktisch keine Quelle mehr.
# Free-Tier: 800 Abrufe pro Tag, 8 pro Minute (wird automatisch eingehalten).
TWELVEDATA_API_KEY=

# Kostenloser FRED-Key (St. Louis Fed): https://fredaccount.stlouisfed.org/apikeys
# Liefert Oelpreis und US-Rendite aus offizieller Quelle. Der handelsgewichtete
# Fed-Dollar-Index ist NUR ueber FRED verfuegbar - ohne Key wird stattdessen
# der klassische DXY angezeigt.
FRED_API_KEY=

# --- Einstellungen (alle optional, Defaults siehe unten) ---
AI_MODEL=claude-haiku-4-5
AI_MAX_TOKENS=8000

# Setzt man SKIP_AI=1, laeuft der Generator ohne Anthropic-Call durch
# (nuetzlich zum Testen des Datenteils).
SKIP_AI=0

DB_PATH=./data/finance.db
OUTPUT_PATH=./public/data/latest.json

# Wie viele Tage Historie in die JSON-Datei (Sparkline) geschrieben werden.
HISTORY_DAYS=90

# Wie viele Tage Historie die Provider pro Lauf abholen sollen.
FETCH_DAYS=180

# Zeitraum fuer "npm run update:quick" - den kurzen Lauf fuer haeufige Takte
# (z.B. alle 15 Minuten). Die lange Historie liegt ja schon in der Datenbank,
# der schnelle Lauf frischt nur die letzten Tage auf.
QUICK_FETCH_DAYS=10

# Port des mitgelieferten statischen Servers (npm run serve)
PORT=8080
# Bind-Adresse. 127.0.0.1 ist sicher, wenn ein Cloudflare Tunnel davor laeuft.
HOST=127.0.0.1
